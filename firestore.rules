rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicit collection rules for PadelMatch

    // Groups: Disallow legacy mock group grp-cruzados-4ta
    match /groups/{groupId} {
      allow read: if true;
      allow create, update: if groupId != 'grp-cruzados-4ta';
      allow delete: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /players/{playerId} {
      allow read, write: if true;
    }

    match /matches/{matchId} {
      allow read, write: if true;
    }

    match /completed_matches/{matchId} {
      allow read, write: if true;
    }

    match /partner_connections/{connId} {
      allow read, write: if true;
    }

    match /partner_posts/{postId} {
      allow read, write: if true;
    }

    match /partner_comments/{commentId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /analytics_events/{eventId} {
      allow read, write: if true;
    }

    match /clubs/{clubId} {
      allow read, write: if true;
    }
  }
}
